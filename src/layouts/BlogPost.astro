---
interface Props {
  title: string;
  pubDate: Date;
  heroImage?: string;
  description?: string;
}

const { title, pubDate, heroImage } = Astro.props;
const formattedDate = pubDate.toLocaleDateString('en-us', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article>
  {heroImage && (
    <div class="hero-image">
      <img width="720" height="360" src={heroImage} alt={title} />
    </div>
  )}
  <div class="prose">
    <nav aria-label="Breadcrumb">
      <ol class="breadcrumb">
        <li><a href="/">Home</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><span aria-current="page">{title}</span></li>
      </ol>
    </nav>
    <div class="title">
      <div class="date">
        <svg width="20" height="20" aria-hidden="true" viewBox="0 0 24 24">
          <path fill="currentColor" d="M19 19H5V8h14m-3-7v2H8V1H6v2H5c-1.11 0-2 .89-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2h-1V1m-1 11h-5v5h5z"/>
        </svg>
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
      </div>
      <h1>{title}</h1>
    </div>
    <div class="content">
      <slot />
    </div>
  </div>
</article>

<style>
  .hero-image {
    width: 100%;
  }
  .hero-image img {
    display: block;
    margin: 0 auto;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,.12);
  }
  .prose {
    width: 820px;
    max-width: calc(100% - 32px);
    margin: auto;
    padding: 1em;
  }
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    font-size: .875rem;
    color: #6b7280;
  }
  .breadcrumb li {
    display: flex;
    align-items: center;
  }
  .breadcrumb li:not(:last-child)::after {
    content: "/";
    margin: 0 .5rem;
    color: #9ca3af;
  }
  .breadcrumb a {
    color: #3b82f6;
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .title {
    margin-bottom: 2rem;
  }
  .date {
    display: flex;
    align-items: center;
    gap: .4rem;
    font-size: .875rem;
    color: #6b7280;
    margin-bottom: .5rem;
  }
  h1 {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
  }
  .content {
    line-height: 1.8;
  }
  .content :global(img) {
    max-width: 100%;
    border-radius: 8px;
  }
  .content :global(pre) {
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
    font-size: .875rem;
  }
  .content :global(h2) {
    margin-top: 2rem;
    font-size: 1.5rem;
  }
  .content :global(h3) {
    margin-top: 1.5rem;
    font-size: 1.25rem;
  }
  .content :global(blockquote) {
    border-left: 3px solid #c3dafe;
    padding-left: 1rem;
    color: #4b5563;
    margin: 1rem 0;
  }
  .content :global(hr) {
    border: none;
    border-top: 1px solid #e5e7eb;
    margin: 2rem 0;
  }
</style>
