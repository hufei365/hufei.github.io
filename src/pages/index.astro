---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sorted = posts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="application/rss+xml" title="HuFei's Site" href="https://hufei365.github.io/rss.xml" />
  <link rel="icon" href={`${base}/favicon.ico`} sizes="48x48" />
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32x32.png`} />
  <link rel="icon" type="image/png" sizes="16x16" href={`${base}/favicon-16x16.png`} />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
  <link rel="manifest" href={`${base}/site.webmanifest`} />
  <title>Blog — HuFei's Site</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 820px; margin: 0 auto; padding: 2rem 1rem; line-height: 1.6; }
    h1 { font-size: 2rem; margin-bottom: 2rem; }
    .post-list { list-style: none; padding: 0; }
    .post-item { margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid #e5e7eb; }
    .post-date { font-size: .875rem; color: #6b7280; margin-bottom: .25rem; }
    .post-title { font-size: 1.25rem; font-weight: 600; margin: 0 0 .5rem; }
    .post-title a { color: inherit; text-decoration: none; }
    .post-title a:hover { text-decoration: underline; color: #3b82f6; }
    .post-desc { font-size: .925rem; color: #4b5563; margin: 0; }
    .post-tags { display: flex; gap: .5rem; margin-top: .5rem; flex-wrap: wrap; }
    .post-tag { font-size: .75rem; background: #f3f4f6; padding: .15rem .5rem; border-radius: 9999px; color: #374151; }
    footer { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid #e5e7eb; text-align: center; color: #9ca3af; font-size: .875rem; }
    footer a { color: #6b7280; }
  </style>
</head>
<body>
  <nav aria-label="主导航"><a href="/">← 返回首页</a></nav>
  <h1>Blog</h1>
  <ul class="post-list">
    {sorted.map((post) => {
      const slug = post.data.slug || post.id.replace(/\.md$/, '');
      return (
        <li class="post-item">
          <div class="post-date">
            {post.data.pubDate.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' })}
          </div>
          <h2 class="post-title">
            <a href={`/blog/${slug}/`}>{post.data.title}</a>
          </h2>
          {post.data.description && (
            <p class="post-desc">{post.data.description}</p>
          )}
          {post.data.tags.length > 0 && (
            <div class="post-tags">
              {post.data.tags.map((tag: string) => (
                <span class="post-tag">{tag}</span>
              ))}
            </div>
          )}
        </li>
      );
    })}
  </ul>
  <footer>
    <a href="/">Home</a>
  </footer>
</body>
</html>
